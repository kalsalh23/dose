{
  "rewrites": [{ "source": "/((?!img/|logo.jpg|sw.js|manifest.webmanifest).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
